# One image that cross-compiles the jssc natives for every supported target.
#
# The Linux and Windows toolchains are copied unchanged out of the dockcross images that
# cross-compile.yml used to run one by one, pinned by digest, so the natives keep the same
# compilers, sysroots and glibc floor. Nothing is installed with a package manager in the image
# that builds the natives: the JDK and Maven come from checksummed tarballs.
#
# Stages (podman build --target <stage>):
#   linux-windows  linux_* and windows_* targets
#   jssc-cross     + osxcross for osx_*, without the Apple SDK (redistributable)
#   jssc-cross-sdk + MacOSX11.3.sdk (default; Apple's license forbids redistribution, keep it private)
#
# Run a build with builder/cross-compile.sh, or: jssc-target <target> <command>

FROM docker.io/dockcross/linux-x86@sha256:a4761958b78c872a50c78c3891fbd8a03a8ab8d0fc1278e73c2aed58a0303a28 AS linux-x86
FROM docker.io/dockcross/linux-x64@sha256:89a2c6061215d923a940902fbb2c3c42fdd8a4819d2bd3d7176602f34335f075 AS linux-x64
FROM docker.io/dockcross/linux-armv6-lts@sha256:809eeb54c68f6a2509dbcf4acbcaed1b5e8da2124129e43a13da8368e556258f AS linux-armv6-lts
FROM docker.io/dockcross/linux-arm64-lts@sha256:2c5e62a9162848a6b551c0a55672b6a9769870c41f0317a00a6b86d9949d60f6 AS linux-arm64-lts
FROM docker.io/dockcross/linux-riscv32@sha256:55e64724e17a1773ecb9eeb679d0bc8295f61c61d9cbe6f851d6f7b95a367f2c AS linux-riscv32
FROM docker.io/dockcross/linux-riscv64@sha256:0fba39717a682a4a2262e20c5af2a30fc5732d73c83b2ac36a81347615b7eff5 AS linux-riscv64
FROM docker.io/dockcross/linux-ppc64le@sha256:c4c81aa8fa076a3c5a12931b4b28ed1ed1928103d10d6648240a157910f75234 AS linux-ppc64le
FROM docker.io/dockcross/windows-static-x86@sha256:e16afcac6a9e7577444f38fc6ee22db5eba9a960747c3cc1569cc5a081ec9506 AS windows-static-x86
FROM docker.io/dockcross/windows-static-x64@sha256:4ba71b3c55b8d4b6b756c217306c7458ba2fea97081acae66a3421093adc15b9 AS windows-static-x64
FROM docker.io/dockcross/windows-arm64@sha256:7a76f4d44a721da0788cf254ab1b3288b33ab75e8cbc4684e564bc3b65c1c97f AS windows-arm64

FROM linux-x86 AS downloads
ARG JDK_URL=https://github.com/adoptium/temurin11-binaries/releases/download/jdk-11.0.32.1%2B1/OpenJDK11U-jdk_x64_linux_hotspot_11.0.32.1_1.tar.gz
ARG JDK_SHA256=5c3f68887c325d36d852ba534303e1f5f1f5cae7d6cc1e951d73e0d8e98a058d
ARG MAVEN_URL=https://archive.apache.org/dist/maven/maven-3/3.9.11/binaries/apache-maven-3.9.11-bin.tar.gz
ARG MAVEN_SHA512=bcfe4fe305c962ace56ac7b5fc7a08b87d5abd8b7e89027ab251069faebee516b0ded8961445d6d91ec1985dfe30f8153268843c89aa392733d1a3ec956c9978
RUN curl -fsSL -o /tmp/jdk.tar.gz "$JDK_URL" \
 && echo "$JDK_SHA256  /tmp/jdk.tar.gz" | sha256sum -c \
 && mkdir /opt/jdk && tar -xzf /tmp/jdk.tar.gz -C /opt/jdk --strip-components=1 \
 && curl -fsSL -o /tmp/maven.tar.gz "$MAVEN_URL" \
 && echo "$MAVEN_SHA512  /tmp/maven.tar.gz" | sha512sum -c \
 && mkdir /opt/maven && tar -xzf /tmp/maven.tar.gz -C /opt/maven --strip-components=1

# linux-x86 is linux-x64 plus gcc-multilib (same gcc 10.2.1-6, glibc 2.31-13+deb11u7), so it serves
# linux_32 and linux_64 alike; every other toolchain lives in one directory of its own image.
# The two MXE trees share their host tools, and those files are identical.
FROM linux-x86 AS linux-windows
COPY --from=linux-x64 /usr/lib/x86_64-linux-gnu/Toolchain.cmake /usr/lib/x86_64-linux-gnu/Toolchain.cmake
COPY --from=linux-armv6-lts /usr/xcc/armv6-unknown-linux-gnueabihf /usr/xcc/armv6-unknown-linux-gnueabihf
COPY --from=linux-arm64-lts /usr/xcc/aarch64-unknown-linux-gnu /usr/xcc/aarch64-unknown-linux-gnu
COPY --from=linux-riscv32 /usr/xcc/riscv32-unknown-linux-gnu /usr/xcc/riscv32-unknown-linux-gnu
COPY --from=linux-riscv32 /usr/lib/riscv32-unknown-linux-gnu /usr/lib/riscv32-unknown-linux-gnu
COPY --from=linux-riscv64 /usr/xcc/riscv64-unknown-linux-gnu /usr/xcc/riscv64-unknown-linux-gnu
COPY --from=linux-riscv64 /usr/lib/riscv64-unknown-linux-gnu /usr/lib/riscv64-unknown-linux-gnu
COPY --from=linux-ppc64le /usr/xcc/powerpc64le-unknown-linux-gnu /usr/xcc/powerpc64le-unknown-linux-gnu
COPY --from=linux-ppc64le /usr/lib/powerpc64le-unknown-linux-gnu /usr/lib/powerpc64le-unknown-linux-gnu
COPY --from=windows-static-x86 /usr/src/mxe/usr /usr/src/mxe/usr
COPY --from=windows-static-x64 /usr/src/mxe/usr /usr/src/mxe/usr
COPY --from=windows-arm64 /usr/xcc/aarch64-w64-mingw32-cross /usr/xcc/aarch64-w64-mingw32-cross
COPY --from=downloads /opt/jdk /opt/jdk
COPY --from=downloads /opt/maven /opt/maven
COPY targets/ /opt/jssc/targets/
COPY jssc-target /usr/local/bin/jssc-target
# Blank the linux-x86 toolchain variables, so nothing builds for linux_32 by accident;
# jssc-target sets the ones of the selected target
ENV CROSS_TRIPLE= CROSS_ROOT= AS= AR= CC= CPP= CXX= LD= CMAKE_TOOLCHAIN_FILE= CROSS_COMPILE= ARCH= \
    DEFAULT_DOCKCROSS_IMAGE= \
    JAVA_HOME=/opt/jdk MAVEN_HOME=/opt/maven \
    PATH=/opt/jdk/bin:/opt/maven/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /work
ENTRYPOINT []
CMD ["bash"]

# osxcross (cctools/ld64 "stable" flavor) built with the clang 14 of llvm-mingw from the
# windows-arm64 image, which is also the compiler the osxcross wrappers run. Only this
# throw-away stage uses apt (archive.debian.org, for the libxml2 headers xar needs).
FROM linux-x64 AS osxcross
ARG OSXCROSS_COMMIT=27d21e4977c9751d01199c7a226a6faf494c3dd9
ARG XAR_COMMIT=5fa4675419cfec60ac19a9c7f7c2d0e7c831a497
ARG TAPI_COMMIT=640b4623929c923c0468143ff2a363a48665fa54
ARG CCTOOLS_COMMIT=e101a6940dcb5988808a16626bc43851f00dc05f
ARG SDK_URL=https://github.com/phracker/MacOSX-SDKs/releases/download/11.3/MacOSX11.3.sdk.tar.xz
ARG SDK_SHA256=cd4f08a75577145b8f05245a2975f7c81401d75e9535dcffbb879ee1deefcbf4
COPY --from=windows-arm64 /usr/xcc/aarch64-w64-mingw32-cross /usr/xcc/aarch64-w64-mingw32-cross
RUN sed -i -e 's/deb.debian.org/archive.debian.org/' -e 's/security.debian.org/archive.debian.org/' /etc/apt/sources.list \
 && apt-get update && apt-get install --yes --no-install-recommends libxml2-dev \
 && rm -rf /var/lib/apt/lists/*
RUN fetch() { mkdir -p "$1" && git -C "$1" init -q && git -C "$1" fetch -q --depth 1 "$2" "$3" && git -C "$1" checkout -q FETCH_HEAD; } \
 && fetch /src/osxcross https://github.com/tpoechtrager/osxcross.git "$OSXCROSS_COMMIT" \
 && fetch /src/deps/xar https://github.com/tpoechtrager/xar.git "$XAR_COMMIT" \
 && fetch /src/deps/apple-libtapi https://github.com/tpoechtrager/apple-libtapi.git "$TAPI_COMMIT" \
 && fetch /src/deps/cctools-port https://github.com/tpoechtrager/cctools-port.git "$CCTOOLS_COMMIT" \
 && curl -fsSL -o /src/osxcross/tarballs/MacOSX11.3.sdk.tar.xz "$SDK_URL" \
 && echo "$SDK_SHA256  /src/osxcross/tarballs/MacOSX11.3.sdk.tar.xz" | sha256sum -c
# TP_OSXCROSS_DEV: build xar, tapi and cctools from the pinned checkouts instead of branch heads.
# Without the dockcross toolchain variables: CMake reads CMAKE_TOOLCHAIN_FILE from the environment
# and would treat this host build as a cross build (and CC would pick gcc instead of clang).
RUN cd /src/osxcross \
 && env -u CMAKE_TOOLCHAIN_FILE -u CROSS_TRIPLE -u CROSS_ROOT -u AS -u AR -u CPP -u LD -u FC \
    CC=clang CXX=clang++ PATH=/usr/xcc/aarch64-w64-mingw32-cross/bin:$PATH \
    UNATTENDED=1 BUILD_FLAVOR=stable SDK_VERSION=11.3 \
    TARGET_DIR=/opt/osxcross TP_OSXCROSS_DEV=/src/deps DISABLE_LTO_SUPPORT=1 JOBS=$(nproc) ./build.sh \
 && mkdir /sdk && mv /opt/osxcross/SDK/MacOSX11.3.sdk /sdk/

FROM linux-windows AS jssc-cross
COPY --from=osxcross /opt/osxcross /opt/osxcross

FROM jssc-cross AS jssc-cross-sdk
COPY --from=osxcross /sdk/MacOSX11.3.sdk /opt/osxcross/SDK/MacOSX11.3.sdk
